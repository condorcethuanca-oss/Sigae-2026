# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Clave criptográfica para firma de tokens HMAC-SHA256 del servidor SIGAE.
# Requerida en producción si se habilita ALLOW_LOCAL_HMAC_TOKENS (mínimo 32 caracteres).
# En desarrollo, el servidor genera automáticamente una clave efímera de 256 bits si no se provee.
JWT_SECRET="ejemplo_clave_criptografica_segura_minimo_32_caracteres_sigae_80730142"

# ALLOW_LOCAL_HMAC_TOKENS: Controla si se permiten tokens HMAC locales en el backend.
# En producción debe ser 'false' para exigir exclusivamente Firebase ID Tokens oficiales verificados.
ALLOW_LOCAL_HMAC_TOKENS="true"

# GOOGLE_APPLICATION_CREDENTIALS: Ruta al archivo JSON de cuenta de servicio de Firebase (opcional).
# Requerido únicamente para operaciones administrativas directas del Admin SDK en producción.
# GOOGLE_APPLICATION_CREDENTIALS="/ruta/a/serviceAccountKey.json"
